# Скопируйте в .env и заполните. .env в git не коммитится.

# PostgreSQL. Для локальной разработки: npm run db:up (поднимает БД в Docker)
DATABASE_URL="postgresql://disputekz:disputekz@localhost:5432/disputekz?schema=public"

# Для docker-compose.yml
DB_USER=disputekz
DB_PASSWORD=disputekz

# Первый суперадмин, создаётся командой npm run db:seed
SEED_SUPERADMIN_EMAIL=admin@disputekz.kz
SEED_SUPERADMIN_PASSWORD=change-me-please
SEED_SUPERADMIN_NAME="Администратор платформы"

# 1 — дополнительно создать демо-банк с отделениями, сотрудниками и диспутами
SEED_DEMO=1
